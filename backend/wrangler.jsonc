{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "via-tracker-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "SOURCE_URL": "https://tsimobile.viarail.ca/data/allData.json",
    "APNS_BUNDLE_ID": "com.junxuanb.viatracker"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "via-tracker",
      "database_id": "79096f0b-9602-486a-8b78-790ed4b83f9d",
      "migrations_dir": "migrations"
    }
  ],
  "unsafe": {
    "bindings": [
      {
        "name": "INSTALLATION_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": {
          "limit": 10,
          "period": 60
        }
      },
      {
        "name": "WRITE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": {
          "limit": 60,
          "period": 60
        }
      }
    ]
  },
  "env": {
    "test": {
      "name": "via-tracker-test",
      "main": "src/test-worker.ts",
      "vars": {
        "SOURCE_URL": "https://tsimobile.viarail.ca/data/allData.json",
        "APNS_BUNDLE_ID": "com.junxuanb.viatracker"
      },
      "assets": {
        "directory": "tools/test-console",
        "binding": "TEST_ASSETS",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "via-tracker-test",
          "database_id": "a98f15cd-8f2c-4ee1-8160-46661d83ed96",
          "migrations_dir": "test-migrations"
        }
      ],
      "unsafe": {
        "bindings": [
          {
            "name": "INSTALLATION_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1003",
            "simple": {
              "limit": 10,
              "period": 60
            }
          },
          {
            "name": "WRITE_LIMITER",
            "type": "ratelimit",
            "namespace_id": "1004",
            "simple": {
              "limit": 60,
              "period": 60
            }
          }
        ]
      },
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      }
    }
  }
}
