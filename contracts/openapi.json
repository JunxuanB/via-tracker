{
  "openapi": "3.1.0",
  "info": {
    "title": "VIA Tracker API",
    "version": "1.0.0",
    "description": "No account. Bearer value is installationID:credential. Times use ISO8601 with offsets; planning and ActivityState timestamps are Unix seconds. Ordinary and activity tokens are separate. Snapshot and client revision are separate dimensions. Upstream fields are observations, not a VIA guarantee. Journey progress automatically follows estimated event times, falling back to scheduled times; automatic arrival is a display projection, not a station actual-event record. Equal client revisions are idempotent and never overwrite the stored winner."
  },
  "servers": [
    {
      "url": "https://via-tracker-api.junxuan-bao.workers.dev"
    },
    {
      "url": "http://127.0.0.1:8787"
    }
  ],
  "security": [
    {
      "installation": []
    }
  ],
