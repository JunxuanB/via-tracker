    "/v1/widget-token": {
      "put": {
        "summary": "Register the WidgetKit token separately from ordinary and Live Activity tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token",
                  "environment"
                ],
                "properties": {
                  "token": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{32,512}$",
                    "description": "Even-length hexadecimal APNs WidgetKit token."
                  },
                  "environment": {
                    "type": "string",
                    "enum": [
                      "sandbox",
                      "production"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Registered for the authenticated installation and matching APNs environment"
          },
          "400": {
            "description": "Invalid token or environment"
          },
          "401": {
            "description": "Invalid installation credential"
          },
          "409": {
            "description": "APNs environment does not match the installation"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      },
      "delete": {
        "summary": "Unregister WidgetKit pushes when switching environments",
        "responses": {
          "200": {
            "description": "Removed"
          },
          "401": {
            "description": "Invalid installation credential"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "installation": {
        "type": "http",
        "scheme": "bearer",
        "description": "installationID:64-character device credential"
      }
    },
    "schemas": {
      "EventTime": {
        "type": "object",
        "properties": {
          "scheduled": {
            "type": "string",
            "format": "date-time"
          },
          "estimated": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "scheduled"
        ]
      },
      "StationCall": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "timeZone": {
            "type": "string"
          },
          "arrival": {
            "$ref": "#/components/schemas/EventTime"
          },
          "departure": {
            "$ref": "#/components/schemas/EventTime"
          },
          "reached": {
            "type": "boolean",
            "description": "VIA per-station eta == ARR flag; not an actual arrival timestamp. Absent on reference schedules."
          }
        },
        "required": [
          "index",
          "code",
          "name",
          "timeZone"
        ]
      },
      "Position": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number"
          },
          "longitude": {
            "type": "number"
          },
          "reportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "speedKmh": {
            "type": "number",
            "minimum": 0,
            "maximum": 400,
            "description": "Last reported speed in km/h, from VIA speed."
          },
          "heading": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360,
            "description": "Last reported heading clockwise from north."
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "Alert": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
